{
  "name": "pics-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pics.me — the fast picture stream with an AI remix studio",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
