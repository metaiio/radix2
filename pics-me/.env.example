# Server
PORT=3000
DATA_DIR=./data
# Public origin used in share links / Open Graph tags
PUBLIC_URL=https://pics.me
# Set to 1 when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=1
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=1
MAX_IMAGE_MB=25
MAX_VIDEO_MB=60

# AI — with a key, captions / ad copy / storyboards come from Claude vision.
# Without one, the app falls back to built-in templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Comma-separated usernames who can review reported posts at /admin
ADMIN_USERS=

# Origins of the bundled Android/iOS apps (they call the API with bearer tokens)
APP_ORIGINS=capacitor://localhost,https://localhost

# Self-hosted / SLYD inference (any OpenAI-compatible server: vLLM, llama.cpp).
# When AI_BASE_URL is set it is used instead of Claude.
AI_BASE_URL=            # e.g. http://10.0.0.5:8000/v1
AI_API_KEY=             # if the endpoint needs one
AI_MODEL=               # the served model name, e.g. Qwen3-30B-A3B
AI_VISION=0             # 1 only if the model accepts images
AI_EXTRA_BODY=          # optional JSON merged into requests, e.g. {"chat_template_kwargs":{"enable_thinking":false}}
