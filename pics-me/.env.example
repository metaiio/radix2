# Server
PORT=3000
DATA_DIR=./data
# Public origin used in share links / Open Graph tags
PUBLIC_URL=https://pics.me
# Set to 1 when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=1
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=1
MAX_IMAGE_MB=25
MAX_VIDEO_MB=60

# AI — with a key, captions / ad copy / storyboards come from Claude vision.
# Without one, the app falls back to built-in templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Comma-separated usernames who can review reported posts at /admin
ADMIN_USERS=
